# TriviaVerse Environment Configuration
# Copy this file to .env and fill in your values

# Application
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key
FLASK_ENV=development
PORT=5000

# Database
DATABASE_URL=sqlite:///triviaverse.db
MIGRATION_DATABASE_URL=
DATABASE_SSLMODE=
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/triviaverse
# Supabase URLs automatically use sslmode=require. DATABASE_URL should use
# the session pooler (5432); MIGRATION_DATABASE_URL should use direct access.

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Supabase (website project). The publishable key may be exposed to the
# browser; the secret key and database URLs must remain server-only.
SUPABASE_URL=https://rqohugxyvdomjmcvknde.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_ENABLED=0

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token

# Discord Error Webhook
DISCORD_ERROR_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Owner Configuration
OWNER_USERNAME=your_admin_username
OWNER_DISCORD_ID=
OWNER_EMAIL=

# API
API_BASE_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:5000

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://

# CDN (optional)
CDN_BASE_URL=

# SocketIO
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_CORS_ALLOWED_ORIGINS=http://localhost:5000

# Explicit runtime lifecycle controls. Keep AUTO_INIT_DATABASE disabled in
# production; deploy migrations before starting the web service.
AUTO_INIT_DATABASE=1
ENABLE_SCHEDULER=0
LOG_TO_FILE=0

# Regions
REGIONS=eu,na,asia,mn,jp,kr,ru

# Cloudflare (optional)
CLOUDFLARE_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

